# Sanity write token for client-side development (do not commit a real token into source control)
VITE_SANITY_WRITE_TOKEN=your_sanity_write_token_here

# Server-side Sanity token used by /api/place-order and other serverless endpoints
SANITY_SECRET_API_TOKEN=your_sanity_secret_api_token_here

# Gmail SMTP credentials for sending emails
EMAIL_USER=your.email@gmail.com
EMAIL_APP_PASSWORD=your_app_password_here
